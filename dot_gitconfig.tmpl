[core]
    pager = delta
    quotepath = false
[interactive]
    diffFilter = delta --color-only
[delta]
    syntax-theme = GitHub
    line-numbers = true
    hunk-header-style = syntax
[merge]
    conflictStyle = zdiff3
[user]
    name = {{ .git_name | quote }}
    email = {{ .git_email | quote }}
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = true
[init]
	defaultBranch = main
