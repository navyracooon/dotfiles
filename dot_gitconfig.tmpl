[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    line-numbers = true
    hunk-header-style = syntax
[merge]
    conflictStyle = zdiff3
[user]
    name = {{ .git_name }}
    email = {{ .git_email }}
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = true
[init]
	defaultBranch = main
[core]
    quotepath = false
