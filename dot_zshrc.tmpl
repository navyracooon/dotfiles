[[ -o interactive ]] || return

# general

## setopts
setopt correct

setopt extended_glob

setopt interactive_comments

setopt no_beep
setopt nolistbeep

setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_silent

typeset -g KEYTIMEOUT=1

## history
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt hist_verify
setopt share_history
setopt inc_append_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks

## bindkey
bindkey -v

# aliases

{{- if eq .chezmoi.os "darwin" }}
alias ls='ls -G'
alias la='ls -aG'
alias ll='ls -lhG'
alias lla='ls -lhaG'
{{- else if eq .chezmoi.os "linux" }}
alias ls='ls --color=auto'
alias la='ls -a --color=auto'
alias ll='ls -lh --color=auto'
alias lla='ls -lha --color=auto'
{{- end }}

alias cm='chezmoi -v'

alias ..='cd ..'
alias ...='cd ../..'

alias pd='popd'

alias cl='clear'

alias vi='nvim'
alias vim='nvim'
alias vimrc='(cd "$(chezmoi source-path ~/.config/nvim)" && nvim init.lua && chezmoi -v apply ~/.config/nvim)'

alias zshrc='chezmoi edit --hardlink=false ~/.zshrc && chezmoi -v apply ~/.zshrc && source ~/.zshrc'

alias history='history 0'

alias py='python3'
alias python='python3'
alias pip='pip3'

alias g='git'
alias ga='git add -A'
alias gd='git diff'
alias gds='git diff --staged'

alias t='tmux'
alias tls='tmux ls'
alias ta='tmux a'
alias tk='tmux kill-session'
alias tks='tmux kill-server'
alias tsyn='tmux set synchronize on'
alias ten='tmux set synchronize off ; clear'
alias tmuxrc='chezmoi edit --hardlink=false ~/.tmux.conf && chezmoi -v apply ~/.tmux.conf && tmux source-file ~/.tmux.conf'

tp () {
    local pane=${1:-3}
    sh ~/.chezmoi/scripts/tmux/rearrange-pane${pane}.sh
}

tsw() {
    local source_window=${1:-.}
    local target_window=${2:-!}
    tmux swap-window -s "$source_window" -t "$target_window"
}

# envs

export EDITOR='nvim'

## homebrew
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_NO_AUTO_UPDATE=1
{{- end }}

## fzf
(( $+commands[fzf] )) && eval "$(fzf --zsh)"

### compinit
autoload -Uz compinit && compinit

### direnv
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

## sheldon
eval "$(sheldon source)"

# startups
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
[[ -z "$TMUX" && -z "$SSH_CONNECTION" ]] && tmux
