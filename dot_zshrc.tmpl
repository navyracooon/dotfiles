# general

## setopts
setopt correct

setopt extended_glob

setopt interactive_comments

setopt no_beep
setopt nolistbeep

setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_silent

typeset -g KEYTIMEOUT=1

## history
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt hist_verify
setopt share_history
setopt inc_append_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks

## bindkey
bindkey -v

# alias

{{- if eq .chezmoi.os "darwin" }}
alias ls='ls -G'
alias la='ls -aG'
alias ll='ls -lG'
alias lla='ls -laG'
{{- else if eq .chezmoi.os "linux" }}
alias ls='ls --color=auto'
alias la='ls -a --color=auto'
alias ll='ls -l --color=auto'
alias lla='ls -la --color=auto'
{{- end }}

alias cm='chezmoi -v'

alias ..='cd ..'
alias ...='cd ../..'

alias pd='popd'

alias vi='nvim'
alias vim='nvim'
alias vimrc='(cd ~/.local/share/chezmoi/dot_config/nvim/ && nvim init.lua && chezmoi apply)'

alias zshrc='chezmoi edit ~/.zshrc && chezmoi apply && source ~/.zshrc'

alias history='history 0'

alias py='python3'
alias python='python3'
alias pip='pip3'

alias g='git'
alias ga='git add -A'

alias t='tmux'
alias tls='tmux ls'
alias ta='tmux a'
alias tk='tmux kill-session'
alias tks='tmux kill-server'
alias tsyn='tmux set synchronize on'
alias ten='tmux set synchronize off ; clear'
alias tmuxrc='chezmoi edit ~/.tmux.conf && chezmoi apply && tmux source-file ~/.tmux.conf'

tp () {
    local pane=${1:-3}
    sh ~/.scripts/tmux/rearrange-pane${pane}.sh
}

tsw() {
    local source_window=${1:-.}
    local target_window=${2:-!}
    tmux swap-window -s "$source_window" -t "$target_window"
}

# env

export EDITOR='nvim'

## homebrew
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_NO_AUTO_UPDATE=1
{{- end }}

## sheldon
eval "$(sheldon source)"

## fzf
eval "$(fzf --zsh)"

### compinit
autoload -Uz compinit && compinit

### direnv
eval "$(direnv hook zsh)"

# startup
[[ $- != *i* ]] && return
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
[[ -z "$TMUX" ]] && tmux
